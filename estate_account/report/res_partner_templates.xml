<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Estate Property Template -->
    <template id="report_contact_template">
        <div class="page">
            <table class="table">
                <thead>
                    <tr class="fw-bold">
                        <th>
                            <strong>Name</strong>
                        </th>
                        <th>
                            <strong>Email</strong>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="docs" t-as="contacts">
                        <t t-call="web.html_container">
                            <tr t-foreach="contacts" t-as="contact">
                                <td>
                                    <span t-field="contact.name" />
                                </td>
                                <td>
                                    <span t-field="contact.email" />
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>

    </template>
</odoo>