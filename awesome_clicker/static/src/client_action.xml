<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.client_action">
            <ClickerValue />
            <button class="btn btn-primary" t-on-click="onOpenClicker">Open</button>
    </t>

    <t t-name="awesome_clicker.client_action_open">
        <div class="container mt-4 p-4 shadow-sm">
            <div class="d-flex gap-2">
                <ClickerValue />
                <button t-on-click="() => this.clicker.increment(10)" class="btn btn-primary">Increment</button>                
            </div>
            <h1>Bots</h1>
            <div class="d-flex gap-2">
                <div class="card">
                    <div class="card-header"> <t t-esc="this.clicker.bot.clickBots.value"/>X ClickBots (10 Clicks/10second)</div>
                    <div class="card-body">
                        <button t-on-click="() => this.clicker.buyBot()" class="btn btn-primary"
                        t-attf-class="{{ (this.clicker.clicks >= 1000) ? '' : 'disabled' }}">
                            Buy ClickBot (1000 clicks)
                        </button>                
                    </div>                
                </div>

                <div class="card">
                    <div class="card-header"> <t t-esc="this.clicker.bot.bigBots.value"/>X BigBots (100 Clicks/10second)</div>
                    <div class="card-body">
                        <button t-on-click="() => this.clicker.buyBigBot()" class="btn btn-primary"
                        t-attf-class="{{ (this.clicker.clicks gte 1000) ? '' : 'disabled' }}">
                            Buy BigBot (5000 clicks)
                        </button>                
                    </div>                
                </div>
            </div>


            <div class="text-center">
                <button class="btn btn-primary w">Ok</button>
            </div>
        </div>                      
    </t>
</templates>