<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="awesome_clicker.client_action">
            <button class="btn btn-primary" t-on-click="onOpenClicker">Open</button>
    </t>

    <t t-name="awesome_clicker.client_action_open">
        <div class="container mt-4 p-4 shadow-sm">
        <div class="d-flex gap-2">
            <h3> Click: <t t-esc="this.clickerService.state.clicks" /></h3>
            <button t-on-click="() => this.clickerService.increment(10)" class="btn btn-primary">Increment</button>                
        </div>
            <div class="text-center">
                <button class="btn btn-primary w-50">Ok</button>
            </div>
        </div>                      
    </t>
</templates>