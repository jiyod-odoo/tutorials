<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'after-footer')]" position="before">
            <div class="print d-flex justify-content-center text-center mt-3">
                <t t-esc="pos.config.congratulatory_text ? pos.config.congratulatory_text : 'Congratulation Customer !!'"/>
            </div>
        </xpath>
    </t>
</templates>