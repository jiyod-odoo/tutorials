<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'section-order')]" position="after">
            <div class="section-logistics mt-3 mb-4 pt-4 pb-4 text-start">
                <h3 class="section-title">Logistics</h3>
                <div class="d-flex flex-column gap-2"> 
                    <div class="d-flex justify-content-between" t-on-click="() => console.log(this.props.productTemplate)">
                        <label class="fw-bold mr-2">Weight: </label>
                        <span t-esc="'0.01'"/>
                    </div>
                    <div class="d-flex justify-content-between" t-on-click="() => console.log(this.pos.config)">
                        <label class="fw-bold mr-2">Volume: </label>
                        <span t-esc="'0.00'"/>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>