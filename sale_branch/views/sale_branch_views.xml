<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Sale Branch Form -->
    <record id="sale_branch_view_form" model="ir.ui.view">
        <field name="name">sale.branch.form</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <form string="Sale Branch Form">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="code" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Sale Branch List -->
    <record id="sale_branch_view_list" model="ir.ui.view">
        <field name="name">sale.branch.list</field>
        <field name="model">sale.branch</field>
        <field name="arch" type="xml">
            <list string="sale_branch_list">
                <field name="name" />
                <field name="code" />
            </list>
        </field>
    </record>

    <!-- Configuration Sale Branch -->
    <record id="sale_branch_action" model="ir.actions.act_window">
        <field name="name">Sale Branch</field>
        <field name="res_model">sale.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>