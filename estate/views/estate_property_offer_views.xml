<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Estate Property Offer Form -->
    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Offer Form">
                <sheet>
                    <group>
                        <group>
                            <field name="price" />
                            <field name="partner_id" />
                            <field name="status" />
                            <field name="validity" />
                            <field name="date_deadline" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Estate Properties Offer by Type Action -->
    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Offer By Property Type</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field>
    </record>

    <!-- Estate Property Offer List -->
    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="estate_property_list" editable="bottom"
                decoration-danger="status == 'refused'"
                decoration-success="status == 'accepted'">
                <field name="price" />
                <field name="partner_id" />
                <field name="validity" />
                <!-- <field name="date_deadline" column_invisible="parent.state == 'sold'" /> -->
                <button name="handle_accepted" type="object" icon="fa-check" invisible="status" />
                <button name="handle_refused" type="object" icon="fa-times" invisible="status" />
                <field name="status" />
            </list>
        </field>
    </record>

</odoo>